  "LM.prompt_phase1(cot)": [
   "<|im_start|>system\n# Instruction\nGenerate audio semantic tokens based on the given conditions:\n\n<|im_end|>\n<|im_start|>user\n# Caption\nAn upbeat synth-pop song with punchy drums, bright synth leads and a female vocal\n\n# Lyric\n[Verse]\nCity lights are calling me\nNeon rivers in the street\n[Chorus]\nWe are dancing in the night\nHold me close and hold me tight\n<|im_end|>\n<|im_start|>assistant\n"
  ],
